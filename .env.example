JWT_SECRET=change-me-in-production

# URL сайта в браузере (через запятую, если несколько)
CORS_ORIGIN=http://localhost:3000

# Браузер: /api при nginx или полный URL на проде
NUXT_PUBLIC_API_BASE=/api

# SSR и прокси Nitro (Docker: http://backend:3001)
NUXT_API_BASE=http://127.0.0.1:3001/api
NUXT_API_PROXY_TARGET=http://127.0.0.1:3001
